# Production settings for docker-compose. Copy to .env.production on the server, fill in every
# value, and keep the file out of git (chmod 600). The server refuses to start when a required
# value is missing or weak (see the [env] lines in `docker compose logs app`).

# ── Required ──
DOMAIN=portal.example.in
NEXT_PUBLIC_APP_URL=https://portal.example.in
# openssl rand -base64 32
POSTGRES_PASSWORD=
# openssl rand -base64 48   (changing it signs everyone out)
JWT_SECRET=
COMPANY_EMAIL_DOMAINS=cimp.ac.in
FIREBASE_PROJECT_ID=cimp-aa1ec

# ── Email (required: sign-up codes are emailed). Fill in ONE option ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM="CIMP-BIIF <startup@cimp.ac.in>"
# Emails per second for broadcasts (Resend allows 2 by default)
# MAIL_RATE_PER_SEC=2
SUPPORT_EMAIL=startup@cimp.ac.in

# ── Scheduler: in-app by default. With several app instances, run it in one only:
# SCHEDULER_ENABLED=false elsewhere and call POST /api/cron/<job> with x-cron-secret.
SCHEDULER_ENABLED=true
CRON_SECRET=

# ── File storage: local keeps files in the `uploads` volume; s3 for AWS S3 / R2 / MinIO ──
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# ── Optional ──
ANTHROPIC_API_KEY=
CSP_REPORT_ONLY=false
