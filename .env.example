# Copy to .env.local and fill in
# PostgreSQL via Prisma. Put DATABASE_URL in .env so the Prisma CLI can read it.
# Create the database as UTF-8: CREATE DATABASE cimp_demo ENCODING 'UTF8' TEMPLATE template0;
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/cimp_demo?schema=public
JWT_SECRET=

# Staff (CEO / managers) must use an email on one of these domains (comma-separated).
# Example: COMPANY_EMAIL_DOMAINS=yourcompany.com,yourcompany.in
COMPANY_EMAIL_DOMAINS=

# Firebase project used for Google sign-in (ID tokens are verified against it)
FIREBASE_PROJECT_ID=cimp-aa1ec

# Email (PRD NOT-1): fill in ONE option. Without either, emails are only logged to the terminal.
# Option A: any SMTP server (Amazon SES, Zoho, your hosting provider)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Option B: a Google account with 2-step verification and an app password
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Sender shown to recipients, and the contact address printed in emails
MAIL_FROM="CIMP-BIIF <startup@cimp.ac.in>"
SUPPORT_EMAIL=startup@cimp.ac.in

# Scheduled jobs: the in-app scheduler runs by default. Set SCHEDULER_ENABLED=false when an
# external scheduler calls POST /api/cron/<job> with header x-cron-secret (24+ characters).
SCHEDULER_ENABLED=true
CRON_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
