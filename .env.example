# Copy to .env.local and fill in
# PostgreSQL via Prisma. Put DATABASE_URL in .env so the Prisma CLI can read it.
# Create the database as UTF-8: CREATE DATABASE cimp_demo ENCODING 'UTF8' TEMPLATE template0;
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/cimp_demo?schema=public
JWT_SECRET=

# Staff (CEO / managers) must use an email on one of these domains (comma-separated).
# Example: COMPANY_EMAIL_DOMAINS=yourcompany.com,yourcompany.in
COMPANY_EMAIL_DOMAINS=

# Firebase project used for Google sign-in (ID tokens are verified against it)
FIREBASE_PROJECT_ID=cimp-aa1ec

GMAIL_USER=
GMAIL_APP_PASSWORD=
NEXT_PUBLIC_APP_URL=http://localhost:3000
